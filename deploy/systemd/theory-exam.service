[Unit]
Description=Theory Exam local learning API
After=network.target

[Service]
Type=simple
User=theory-exam
Group=theory-exam
WorkingDirectory=/opt/theory-exam
EnvironmentFile=/etc/theory-exam/theory-exam.env
Environment=NODE_ENV=production
Environment=THEORY_DATA_DIR=/var/lib/theory-exam
ExecStart=/usr/bin/node /opt/theory-exam/apps/server/dist/server.js
Restart=on-failure
RestartSec=5s
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
LockPersonality=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StateDirectory=theory-exam
StateDirectoryMode=0700
ReadWritePaths=/var/lib/theory-exam

[Install]
WantedBy=multi-user.target
