{
  "name": "theory-exam-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "web:dev": "tsx src/web-server.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "web:start": "node dist/web-server.js",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "node scripts/browser-flow-smoke.mjs",
    "test:web:browser": "node scripts/web-entry-browser-smoke.mjs",
    "typecheck": "tsc --noEmit",
    "db:migrate": "tsx src/cli.ts migrate",
    "db:status": "tsx src/cli.ts status",
    "db:clean-test": "tsx src/cli.ts clean-test",
    "db:backup": "tsx src/cli.ts db:backup",
    "db:backup:daily": "tsx src/cli.ts db:backup:daily",
    "db:backup:verify": "tsx src/cli.ts db:backup:verify",
    "db:restore": "tsx src/cli.ts db:restore",
    "updates:sync": "tsx src/cli.ts updates:sync",
    "admin:init": "tsx src/cli.ts admin:init",
    "accounts:provision": "tsx src/cli.ts accounts:provision",
    "verify:local-import": "tsx scripts/verify-local-import.ts"
  },
  "dependencies": {
    "@fastify/multipart": "^9.2.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^10.1.6",
    "@node-rs/argon2": "^2.0.2",
    "exceljs": "^4.4.0",
    "fastify": "^5.6.1"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
