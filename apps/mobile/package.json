{
  "name": "theory-exam-mobile",
  "private": true,
  "version": "1.0.0-dev.1",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "test": "npm run test:ui && npm run test:session",
    "test:ui": "node ./scripts/ui-smoke.mjs",
    "test:session": "../server/node_modules/.bin/tsx --test ./scripts/session-regression.test.mjs",
    "preview": "vite preview",
    "cap:add:android": "cap add android",
    "cap:sync:android": "npm run build && cap sync android",
    "android:debug": "npm run cap:sync:android && cd android && ./gradlew assembleDebug",
    "android:open": "cap open android"
  },
  "dependencies": {
    "@aparajita/capacitor-secure-storage": "^8.0.1",
    "@capacitor-community/file-opener": "^8.0.1",
    "@capacitor-mlkit/barcode-scanning": "^8.2.1",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/network": "^8.0.1",
    "@capacitor/status-bar": "^8.0.4",
    "@tabler/icons-react": "^3.34.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-router-dom": "^7.9.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.3",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.0.4",
    "typescript": "~5.9.3",
    "vite": "^7.1.9"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
